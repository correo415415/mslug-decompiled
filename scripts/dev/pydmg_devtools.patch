+fn apply_input_script(sys: &mut System, args: &Args, frame: u32) {
+    let Some(script) = &args.input_script else { return };
+    let mut mask: u8 = 0;
+    for part in script.split(',') {
+        let part = part.trim();
+        if part.is_empty() { continue; }
+        let (range, m) = part.split_once(':').expect("input_script: FROM-TO:MASK");
+        let (a, b) = range.split_once('-').expect("input_script: FROM-TO");
+        let a: u32 = a.parse().unwrap(); let b: u32 = b.parse().unwrap();
+        if frame >= a && frame < b { mask |= m.parse::<u8>().unwrap(); }
+    }
+    sys.bus.p1_input = !mask;
+}
+
+fn dump_watch_ram(sys: &System, args: &Args, frame: u32) {
+    let Some(w) = &args.watch_ram else { return };
+    let mut line = format!("WATCH f={frame}");
+    for part in w.split(',') {
+        let (a, l) = part.trim().split_once(':').expect("watch_ram: ADDR:LEN");
+        let a = usize::from_str_radix(a.trim_start_matches("0x").trim_start_matches('$'), 16).unwrap();
+        let l: usize = l.parse().unwrap();
+        line.push_str(&format!("  ${a:06X}="));
+        for i in 0..l { line.push_str(&format!("{:02X}", sys.bus.work_ram[(a + i) & 0xFFFF])); }
+    }
+    println!("{line}");
+}
+
+fn apply_pokes(sys: &mut System, args: &Args, frame: u32) {
+    let Some(p) = &args.poke_ram else { return };
+    for part in p.split(',') {
+        let (fr, rest) = part.trim().split_once('@').expect("poke_ram: FRAME@ADDR=HEX");
+        if fr.parse::<u32>().unwrap() != frame { continue; }
+        let (a, hex) = rest.split_once('=').unwrap();
+        let a = usize::from_str_radix(a.trim_start_matches('$'), 16).unwrap();
+        for (i, k) in (0..hex.len()).step_by(2).enumerate() {
+            sys.bus.work_ram[(a + i) & 0xFFFF] = u8::from_str_radix(&hex[k..k + 2], 16).unwrap();
+        }
+        println!("POKE f={frame} ${a:06X}={hex}");
+    }
+}
+
